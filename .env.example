# Runtime connection: Supabase transaction pooler (port 6543). Server-side only.
DATABASE_URL=postgresql://postgres:[PASSWORD]@[PROJECT-REF].pooler.supabase.com:6543/postgres?pgbouncer=true

# Migrations and smoke tests: Supabase session pooler (port 5432). Server-side only.
DIRECT_URL=postgresql://postgres:[PASSWORD]@[PROJECT-REF].pooler.supabase.com:5432/postgres

# Destructive-command guard: set this to the production project ref. db:reset
# refuses to run when DIRECT_URL resolves to this Supabase project.
PRODUCTION_SUPABASE_PROJECT_REF=your-production-project-ref

# Optional: isolated session-pooler URL used only by db:backup-roundtrip.
SCRATCH_DIRECT_URL=postgresql://postgres:[PASSWORD]@[SCRATCH-PROJECT-REF].pooler.supabase.com:5432/postgres

# Private raw-PDF storage and review-only signed URLs. Keep this service role key server-side.
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Temporary Day 5 review access. Replace with real user auth before multi-user release.
ADMIN_TOKEN=replace-with-a-long-random-server-only-token

# Shared PDF extraction for live uploads and ingestion. Server-side only.
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# Local worker only: how long to wait when the discovered-document queue is empty.
WORKER_IDLE_MS=30000
